# signl — copy this file to .env and fill in real values.
# .env is gitignored.

# Kalshi (RSA-PSS signed requests, v2 trade API).
# Generate the key pair at:
#   Demo : https://demo.kalshi.co  → Account & Security → API Keys
#   Prod : https://kalshi.com      → Account & Security → API Keys
# Demo and production credentials are NOT shared — a prod key against the
# demo endpoint returns 401 "NOT_FOUND", and a demo key against prod returns
# 401 "INCORRECT_API_KEY_SIGNATURE".
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/home/ubuntu/kalshi-signl/kalshi-key.pem
# Pick the base that matches where you created the key. Defaults to demo.
# Demo: https://demo-api.kalshi.co/trade-api/v2
#       https://external-api.demo.kalshi.co/trade-api/v2
# Prod: https://api.elections.kalshi.com/trade-api/v2   (current canonical)
#       https://external-api.kalshi.com/trade-api/v2    (legacy alias, still works)
# KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2

# NVIDIA Nemotron via the OpenAI-compatible NIM endpoint.
NVIDIA_API_KEY=
# NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b

# Brave Search (news headlines for sentiment.py).
BRAVE_API_KEY=

# Telegram — consumed by OpenClaw (the node runtime), NOT by Python.
# TELEGRAM_CHAT_ID is the default destination for proactive scan messages.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SQLite database path (defaults to sandbox/workspace/signl.db when unset).
SIGNL_DB_PATH=/home/ubuntu/kalshi-signl/sandbox/workspace/signl.db
